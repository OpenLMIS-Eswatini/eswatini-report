	<parameter name="geographicZone" class="java.lang.String">
		<property name="displayName" value="Geographic Zone"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/geographicZones?levelNumber=2"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="facility" class="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/facilities"/>
		<property name="selectProperty" value="code"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="headerTemplate" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH RECURSIVE zone_tree AS (
  SELECT id FROM referencedata.geographic_zones
   WHERE $P{geographicZone} IS NULL OR id = $P{geographicZone}::uuid
  UNION ALL
  SELECT gz.id FROM referencedata.geographic_zones gz
  JOIN zone_tree zt ON zt.id = gz.parentid
)
SELECT
  f.code AS facilityCode,
  f.name AS facilityName,
  pgz.name AS region,
  to_char(lt.processeddate, 'YYYY-MM-DD') AS dateOfLastTransaction
FROM referencedata.facilities f
JOIN referencedata.geographic_zones gz ON gz.id = f.geographiczoneid
LEFT JOIN referencedata.geographic_zones pgz ON pgz.id = gz.parentid
LEFT JOIN LATERAL (
  SELECT l.processeddate
  FROM stockmanagement.stock_cards sc
  JOIN stockmanagement.stock_card_line_items l ON l.stockcardid = sc.id
  WHERE sc.facilityid = f.id
  ORDER BY l.processeddate DESC NULLS LAST
  LIMIT 1
) lt ON true
WHERE f.active = true
  AND POSITION('_' IN f.code) = 0
  AND (
        ($P{facility} IS NOT NULL
         AND (f.code = $P{facility} OR f.id::varchar = $P{facility}))
     OR ($P{facility} IS NULL AND f.geographiczoneid IN (SELECT id FROM zone_tree))
      )
ORDER BY lt.processeddate ASC NULLS FIRST, pgz.name, f.code]]>
	</queryString>
	<field name="facilityCode" class="java.lang.String"/>
	<field name="facilityName" class="java.lang.String"/>
	<field name="region" class="java.lang.String"/>
	<field name="dateOfLastTransaction" class="java.lang.String"/>
