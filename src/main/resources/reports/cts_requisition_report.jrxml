	<parameter name="program" class="java.lang.String">
		<property name="displayName" value="Program"/>
		<property name="required" value="true"/>
		<property name="selectExpression" value="/api/programs"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="geographicZone" class="java.lang.String">
		<property name="displayName" value="Geographic Zone"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/geographicZones/search"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="facility" class="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/facilities"/>
		<property name="selectProperty" value="code"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="period" class="java.lang.String">
		<property name="displayName" value="Processing Period"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/processingPeriods"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="startDate" class="java.lang.String">
		<property name="displayName" value="Start Date"/>
		<property name="required" value="false"/>
	</parameter>
	<parameter name="endDate" class="java.lang.String">
		<property name="displayName" value="End Date"/>
		<property name="required" value="false"/>
	</parameter>
	<parameter name="headerTemplate" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH RECURSIVE zone_tree AS (
  SELECT id FROM referencedata.geographic_zones
   WHERE $P{geographicZone} IS NULL OR id = $P{geographicZone}::uuid
  UNION ALL
  SELECT gz.id FROM referencedata.geographic_zones gz
  JOIN zone_tree zt ON zt.id = gz.parentid
)
SELECT
  f.code AS facilityCode,
  o.code AS productCode,
  EXTRACT(MONTH FROM pp.startdate)::int AS month,
  EXTRACT(YEAR FROM pp.startdate)::int AS year,
  CEIL(rli.beginningbalance::numeric / NULLIF(o.netcontent, 0))::int AS beginningStock,
  CEIL(rli.totalreceivedquantity::numeric / NULLIF(o.netcontent, 0))::int AS quantityReceived,
  CEIL(rli.totalconsumedquantity::numeric / NULLIF(o.netcontent, 0))::int AS quantityDispensed,
  CEIL(rli.totallossesandadjustments::numeric / NULLIF(o.netcontent, 0))::int AS lossesOrAdjustments,
  CASE
    WHEN rli.totallossesandadjustments > 0 THEN 'Positive Adjustment'
    WHEN rli.totallossesandadjustments < 0 THEN 'Negative Adjustment'
    ELSE NULL
  END AS reasonForAdjustment,
  rli.totalstockoutdays AS daysOutOfStock,
  CEIL(rli.stockonhand::numeric / NULLIF(o.netcontent, 0))::int AS stockOnHand
FROM requisition.requisition_line_items rli
JOIN requisition.requisitions r ON r.id = rli.requisitionid
JOIN referencedata.processing_periods pp ON pp.id = r.processingperiodid
JOIN referencedata.facilities f ON f.id = r.facilityid
JOIN referencedata.orderables o
  ON o.id = rli.orderableid AND o.versionnumber = rli.orderableversionnumber
JOIN referencedata.programs prog ON prog.id = r.programid
WHERE (prog.id::varchar = $P{program} OR prog.name = $P{program})
  AND r.status IN ('APPROVED', 'RELEASED', 'RELEASED_WITHOUT_ORDER')
  AND r.emergency = false
  AND COALESCE(rli.skipped, false) = false
  AND EXISTS (
        SELECT 1 FROM referencedata.program_orderables po
        WHERE po.orderableid = rli.orderableid
          AND po.programid = r.programid
          AND po.fullsupply = true
      )
  AND (
        ($P{facility} IS NOT NULL
         AND (f.code = $P{facility} OR f.id::varchar = $P{facility}))
     OR ($P{facility} IS NULL AND f.geographiczoneid IN (SELECT id FROM zone_tree))
      )
  AND ($P{period} IS NULL OR pp.id::varchar = $P{period} OR pp.name = $P{period})
  AND ($P{startDate} IS NULL OR pp.startdate >= $P{startDate}::date)
  AND ($P{endDate} IS NULL OR pp.startdate <= $P{endDate}::date)
ORDER BY f.code, pp.startdate, o.code]]>
	</queryString>
