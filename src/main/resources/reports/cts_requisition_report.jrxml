	<parameter name="program" class="java.lang.String">
		<property name="displayName" value="Program"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/programs"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="geographicZone" class="java.lang.String">
		<property name="displayName" value="Geographic Zone"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/geographicZones?levelNumber=2"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="facility" class="java.lang.String">
		<property name="displayName" value="Facility"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/facilities"/>
		<property name="selectProperty" value="code"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="period" class="java.lang.String">
		<property name="displayName" value="Processing Period"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/processingPeriods"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="name"/>
	</parameter>
	<parameter name="product" class="java.lang.String">
		<property name="displayName" value="Product"/>
		<property name="required" value="false"/>
		<property name="selectExpression" value="/api/orderables"/>
		<property name="selectProperty" value="id"/>
		<property name="displayProperty" value="fullProductName"/>
	</parameter>
	<parameter name="headerTemplate" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH RECURSIVE zone_tree AS (
  SELECT id FROM referencedata.geographic_zones
   WHERE $P{geographicZone} IS NULL OR id = $P{geographicZone}::uuid
  UNION ALL
  SELECT gz.id FROM referencedata.geographic_zones gz
  JOIN zone_tree zt ON zt.id = gz.parentid
)
SELECT
  f.code AS facilityId,
  EXTRACT(MONTH FROM pp.startdate)::int AS monthId,
  EXTRACT(YEAR FROM pp.startdate)::int AS year,
  o.code AS itemNo,
  CASE prog.code
    WHEN 'em' THEN 'EMP'
    WHEN 'ms' THEN 'MED'
    WHEN 'malaria' THEN 'MAL'
    ELSE UPPER(prog.code)
  END AS itemGroupId,
  CEIL(rli.beginningbalance::numeric / NULLIF(o.netcontent, 0))::int AS openingStock,
  CEIL(rli.totalreceivedquantity::numeric / NULLIF(o.netcontent, 0))::int AS receiveQty,
  CEIL(rli.totalconsumedquantity::numeric / NULLIF(o.netcontent, 0))::int AS dispensedQty,
  (SIGN(rli.totallossesandadjustments) * CEIL(ABS(rli.totallossesandadjustments)::numeric / NULLIF(o.netcontent, 0)))::int AS adjustedQty,
  CASE
    WHEN rli.totallossesandadjustments > 0 THEN 'Positive Adjustment'
    WHEN rli.totallossesandadjustments < 0 THEN 'Negative Adjustment'
    ELSE NULL
  END AS reasonForAdjustId,
  rli.totalstockoutdays AS stockoutDays,
  CEIL(rli.stockonhand::numeric / NULLIF(o.netcontent, 0))::int AS closingStock,
  round(CEIL(rli.stockonhand::numeric / NULLIF(o.netcontent, 0))::numeric / NULLIF(CEIL(rli.averageconsumption::numeric / NULLIF(o.netcontent, 0)), 0), 1) AS mos,
  CEIL(rli.averageconsumption::numeric / NULLIF(o.netcontent, 0))::int AS amc,
  (CEIL(rli.averageconsumption::numeric / NULLIF(o.netcontent, 0)) * 3)::int AS maximumOrderQty,
  CEIL(COALESCE(rli.requestedquantity, rli.calculatedorderquantity)::numeric / NULLIF(o.netcontent, 0))::int AS orderQty,
  CEIL(rli.approvedquantity::numeric / NULLIF(o.netcontent, 0))::int AS actualQtyOrdered
FROM requisition.requisition_line_items rli
JOIN requisition.requisitions r ON r.id = rli.requisitionid
JOIN referencedata.processing_periods pp ON pp.id = r.processingperiodid
JOIN referencedata.facilities f ON f.id = r.facilityid
JOIN referencedata.geographic_zones gz ON gz.id = f.geographiczoneid
JOIN referencedata.orderables o
  ON o.id = rli.orderableid AND o.versionnumber = rli.orderableversionnumber
JOIN referencedata.programs prog ON prog.id = r.programid
WHERE ($P{program} IS NULL OR prog.id::varchar = $P{program} OR prog.name = $P{program})
  AND r.status IN ('APPROVED', 'RELEASED', 'RELEASED_WITHOUT_ORDER')
  AND r.emergency = false
  AND COALESCE(rli.skipped, false) = false
  AND POSITION('_' IN f.code) = 0
  AND EXISTS (
        SELECT 1 FROM referencedata.program_orderables pof
        WHERE pof.orderableid = rli.orderableid
          AND pof.programid = r.programid
          AND pof.fullsupply = true
      )
  AND ($P{product} IS NULL OR o.id::varchar = $P{product})
  AND (
        ($P{facility} IS NOT NULL
         AND (f.code = $P{facility} OR f.id::varchar = $P{facility}))
     OR ($P{facility} IS NULL AND f.geographiczoneid IN (SELECT id FROM zone_tree))
      )
  AND ($P{period} IS NULL OR pp.id::varchar = $P{period} OR pp.name = $P{period})
ORDER BY pp.startdate, prog.code, o.code, f.code, gz.name]]>
	</queryString>
